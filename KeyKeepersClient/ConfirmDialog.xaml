<Window x:Class="KeyKeepersClient.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmation"
        Icon="Images/logo.png"
        Height="220"
        Width="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Style="{StaticResource DialogBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Border Grid.Row="0"
                    Style="{StaticResource TitleBarBorderStyle}"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Confirmation"
                               Style="{StaticResource TitleTextBlockStyle}"
                               Margin="12,0,0,0"/>

                    <Button Grid.Column="1"
                            Style="{StaticResource WindowCloseButtonStyle}"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>
            
            <TextBlock Grid.Row="1"
                       x:Name="MessageText"
                       Text="Message"
                       FontFamily="Bahnschrift"
                       FontSize="16"
                       TextWrapping="Wrap"
                       Foreground="White"
                       Margin="30,25,30,10"/>
            
            <Grid Grid.Row="2"
                  Margin="30,0,30,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="NoButton"
                        Grid.Column="0"
                        Content="No"
                        Style="{StaticResource DeclineButtonStyle}"
                        Click="NoButton_Click"/>

                <Button x:Name="YesButton"
                        Grid.Column="2"
                        Content="Yes"
                        Style="{StaticResource AcceptButtonStyle}"
                        Click="YesButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
