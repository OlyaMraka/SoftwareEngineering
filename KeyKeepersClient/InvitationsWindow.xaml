<Window x:Class="KeyKeepersClient.InvitationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KeyKeepersClient"
        mc:Ignorable="d"
        Title="Community Invitations"
        Icon="Images/logo.png"
        Height="600"
        Width="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Style="{StaticResource DialogBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource TitleBarBorderStyle}"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0"
                           Source="Images/Teams/mail_0.png"
                           Width="24"
                           Height="24"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="Community Invitations"
                               Style="{StaticResource TitleTextBlockStyle}"/>

                    <Button Grid.Column="2"
                            Style="{StaticResource WindowCloseButtonStyle}"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="30">
                <StackPanel x:Name="InvitationsPanel">
                    <!-- TODO: Використати Data Binding для Visibility -->
                    <TextBlock x:Name="NoInvitationsText"
                               Text="No pending invitations"
                               FontFamily="Bahnschrift"
                               FontSize="16"
                               Foreground="#999999"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,50,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2"
                  Margin="30,0,30,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- TODO: Використати Command замість Click event handler -->
                <Button x:Name="DeclineAllButton"
                        Grid.Column="0"
                        Content="Decline All"
                        Style="{StaticResource DeclineButtonStyle}"
                        Click="DeclineAllButton_Click"/>

                <!-- TODO: Використати Command замість Click event handler -->
                <Button x:Name="AcceptAllButton"
                        Grid.Column="2"
                        Content="Accept All"
                        Style="{StaticResource AcceptButtonStyle}"
                        Click="AcceptAllButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
