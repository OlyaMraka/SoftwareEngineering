<Application x:Class="KeyKeepersClient.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KeyKeepersClient">
    <Application.Resources>
        <!-- Window Control Buttons Styles -->

        <!-- Close Button Style (×) -->
        <Style x:Key="WindowCloseButtonStyle"
               TargetType="Button">
            <Setter Property="Width"
                    Value="30"/>
            <Setter Property="Height"
                    Value="30"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FontFamily"
                    Value="Bahnschrift"/>
            <Setter Property="FontSize"
                    Value="24"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="Content"
                    Value="×"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="#C42B1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimize Button Style (—) -->
        <Style x:Key="WindowMinimizeButtonStyle"
               TargetType="Button">
            <Setter Property="Width"
                    Value="30"/>
            <Setter Property="Height"
                    Value="30"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FontFamily"
                    Value="Bahnschrift"/>
            <Setter Property="FontSize"
                    Value="16"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Margin"
                    Value="3,0"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
            <Setter Property="Content"
                    Value="—"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="#2A2F3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Input Field Styles -->

        <!-- Input Border Style -->
        <Style x:Key="InputBorderStyle"
               TargetType="Border">
            <Setter Property="Height"
                    Value="50"/>
            <Setter Property="Background"
                    Value="#2A2F3A"/>
            <Setter Property="CornerRadius"
                    Value="25"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
        </Style>

        <!-- Alternative Input Border Style (for forms) -->
        <Style x:Key="FormInputBorderStyle"
               TargetType="Border">
            <Setter Property="Height"
                    Value="45"/>
            <Setter Property="Background"
                    Value="#0E121B"/>
            <Setter Property="BorderBrush"
                    Value="#222A39"/>
            <Setter Property="BorderThickness"
                    Value="2"/>
            <Setter Property="CornerRadius"
                    Value="10"/>
        </Style>

        <!-- Compact Input Border Style (for SignUp) -->
        <Style x:Key="CompactInputBorderStyle"
               TargetType="Border">
            <Setter Property="Height"
                    Value="40"/>
            <Setter Property="Background"
                    Value="#2A2F3A"/>
            <Setter Property="CornerRadius"
                    Value="20"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
        </Style>

        <!-- Input TextBox Style -->
        <Style x:Key="InputTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="CaretBrush"
                    Value="White"/>
            <Setter Property="FontFamily"
                    Value="Bahnschrift"/>
            <Setter Property="FontSize"
                    Value="16"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>
            <Setter Property="Margin"
                    Value="20,0"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <!-- Form Input TextBox Style (smaller) -->
        <Style x:Key="FormInputTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource InputTextBoxStyle}">
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Padding"
                    Value="15,0"/>
            <Setter Property="Margin"
                    Value="0"/>
        </Style>

        <!-- Compact Input TextBox Style (for SignUp) -->
        <Style x:Key="CompactInputTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource InputTextBoxStyle}">
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Margin"
                    Value="15,0"/>
        </Style>

        <!-- Input PasswordBox Style -->
        <Style x:Key="InputPasswordBoxStyle"
               TargetType="PasswordBox">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="CaretBrush"
                    Value="White"/>
            <Setter Property="FontFamily"
                    Value="Bahnschrift"/>
            <Setter Property="FontSize"
                    Value="16"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>
            <Setter Property="Margin"
                    Value="20,0"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <!-- Compact PasswordBox Style (for SignUp) -->
        <Style x:Key="CompactPasswordBoxStyle"
               TargetType="PasswordBox"
               BasedOn="{StaticResource InputPasswordBoxStyle}">
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Margin"
                    Value="15,0"/>
        </Style>

        <!-- Placeholder TextBlock Style with DataTrigger -->
        <Style x:Key="PlaceholderTextBlockStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#808080"/>
            <Setter Property="FontFamily"
                    Value="Bahnschrift"/>
            <Setter Property="FontSize"
                    Value="16"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="HorizontalAlignment"
                    Value="Left"/>
            <Setter Property="Margin"
                    Value="20,0"/>
            <Setter Property="IsHitTestVisible"
                    Value="False"/>
            <Setter Property="Visibility"
                    Value="Visible"/>
            <Style.Triggers>
                <!-- Hide placeholder when TextBox has text -->
                <DataTrigger Binding="{Binding Text.Length, RelativeSource={RelativeSource AncestorType=Grid}}"
                             Value="0">
                    <Setter Property="Visibility"
                            Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Form Placeholder Style (smaller) -->
        <Style x:Key="FormPlaceholderTextBlockStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource PlaceholderTextBlockStyle}">
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Margin"
                    Value="15,0"/>
        </Style>

        <!-- Compact Placeholder Style (for SignUp) -->
        <Style x:Key="CompactPlaceholderTextBlockStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource PlaceholderTextBlockStyle}">
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Margin"
                    Value="15,0"/>
        </Style>

    </Application.Resources>
</Application>
