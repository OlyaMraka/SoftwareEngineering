<Window x:Class="KeyKeepersClient.UpdateCommunityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KeyKeepersClient"
        mc:Ignorable="d"
        Title="Update Community"
        Icon="Images/logo.png"
        Height="350"
        Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Style="{StaticResource DialogBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource TitleBarBorderStyle}"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0"
                           Source="Images/edit 1.png"
                           Width="24"
                           Height="24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="Edit Community"
                               Style="{StaticResource TitleTextBlockStyle}"/>

                    <Button Grid.Column="2"
                            Style="{StaticResource DialogCloseButtonStyle}"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1"
                        Margin="30,20,30,20">
                <TextBlock Text="Community Name"
                           FontFamily="Bahnschrift"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Margin="0,0,0,8"/>

                <!-- TODO: Використати Data Binding для Text замість TextChanged event -->
                <Border Background="#0E121B"
                        BorderBrush="#222A39"
                        BorderThickness="2"
                        CornerRadius="10"
                        Height="45"
                        Margin="0,0,0,5">
                    <TextBox x:Name="CommunityNameTextBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             FontFamily="Bahnschrift"
                             FontSize="14"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             Padding="15,0"
                             MaxLength="50"
                             TextChanged="CommunityNameTextBox_TextChanged"/>
                </Border>

                <!-- TODO: Використати Data Binding для Text та Visibility -->
                <TextBlock x:Name="NameErrorTextBlock"
                           FontFamily="Bahnschrift"
                           FontSize="12"
                           Foreground="#FF6B6B"
                           Margin="5,0,0,10"
                           Visibility="Collapsed"/>

                <!-- TODO: Використати Data Binding для Text -->
                <TextBlock x:Name="CharacterCountTextBlock"
                           Text="0 / 50 characters"
                           FontFamily="Bahnschrift"
                           FontSize="12"
                           Foreground="#666666"
                           Margin="5,0,0,20"
                           HorizontalAlignment="Right"/>

                <TextBlock Text="Enter a new name for your community."
                           FontFamily="Bahnschrift"
                           FontSize="13"
                           Foreground="#999999"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"/>
            </StackPanel>

            <Grid Grid.Row="2"
                  Margin="30,0,30,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Cancel"
                        Style="{StaticResource DeclineButtonStyle}"
                        Click="CancelButton_Click"/>

                <!-- TODO: Використати Command замість Click event handler -->
                <!-- TODO: Використати Data Binding для IsEnabled -->
                <Button x:Name="SaveButton"
                        Grid.Column="2"
                        Content="Save"
                        Style="{StaticResource AcceptButtonStyle}"
                        IsEnabled="False"
                        Click="SaveButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
