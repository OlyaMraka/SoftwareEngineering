<Window x:Class="KeyKeepersClient.EditUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KeyKeepersClient"
        mc:Ignorable="d"
        Title="Edit Profile"
        Icon="Images/logo.png"
        Height="700"
        Width="550"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#171C26"
            BorderBrush="#FDE053"
            BorderThickness="3"
            CornerRadius="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource TitleBarBorderStyle}"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="👤"
                               FontSize="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="Редагування профілю"
                               Style="{StaticResource TitleTextBlockStyle}"/>

                    <!-- TODO: Використати Command замість Click event handler -->
                    <Button Grid.Column="2"
                            Style="{StaticResource WindowCloseButtonStyle}"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Margin="30,20,30,20">
                <StackPanel>
                    <TextBlock Text="Ім'я"
                               FontFamily="Bahnschrift"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,0,0,8"/>

                    <!-- TODO: Використати Data Binding для Text -->
                    <Border Background="#0E121B"
                            BorderBrush="#222A39"
                            BorderThickness="2"
                            CornerRadius="10"
                            Height="45"
                            Margin="0,0,0,5">
                        <TextBox x:Name="NameTextBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 FontFamily="Bahnschrift"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Padding="15,0"
                                 MaxLength="30"/>
                    </Border>

                    <!-- TODO: Використати Data Binding для Text та Visibility -->
                    <TextBlock x:Name="NameErrorText"
                               Text=""
                               FontFamily="Bahnschrift"
                               FontSize="11"
                               Foreground="#FF6B6B"
                               Margin="5,0,0,15"
                               Visibility="Collapsed"/>

                    <TextBlock Text="Прізвище"
                               FontFamily="Bahnschrift"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,0,0,8"/>

                    <Border Background="#0E121B"
                            BorderBrush="#222A39"
                            BorderThickness="2"
                            CornerRadius="10"
                            Height="45"
                            Margin="0,0,0,5">
                        <TextBox x:Name="SurnameTextBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 FontFamily="Bahnschrift"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Padding="15,0"
                                 MaxLength="30"/>
                    </Border>

                    <TextBlock x:Name="SurnameErrorText"
                               Text=""
                               FontFamily="Bahnschrift"
                               FontSize="11"
                               Foreground="#FF6B6B"
                               Margin="5,0,0,15"
                               Visibility="Collapsed"/>

                    <TextBlock Text="Email"
                               FontFamily="Bahnschrift"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,0,0,8"/>

                    <Border Background="#0E121B"
                            BorderBrush="#222A39"
                            BorderThickness="2"
                            CornerRadius="10"
                            Height="45"
                            Margin="0,0,0,5">
                        <TextBox x:Name="EmailTextBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 FontFamily="Bahnschrift"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Padding="15,0"
                                 MaxLength="40"/>
                    </Border>

                    <TextBlock x:Name="EmailErrorText"
                               Text=""
                               FontFamily="Bahnschrift"
                               FontSize="11"
                               Foreground="#FF6B6B"
                               Margin="5,0,0,15"
                               Visibility="Collapsed"/>

                    <TextBlock Text="Ім'я користувача"
                               FontFamily="Bahnschrift"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,0,0,8"/>

                    <Border Background="#0E121B"
                            BorderBrush="#222A39"
                            BorderThickness="2"
                            CornerRadius="10"
                            Height="45"
                            Margin="0,0,0,5">
                        <TextBox x:Name="UsernameTextBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 FontFamily="Bahnschrift"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Padding="15,0"
                                 MaxLength="40"/>
                    </Border>

                    <TextBlock x:Name="UsernameErrorText"
                               Text=""
                               FontFamily="Bahnschrift"
                               FontSize="11"
                               Foreground="#FF6B6B"
                               Margin="5,0,0,15"
                               Visibility="Collapsed"/>

                    <TextBlock Text="Новий пароль (залиште порожнім, якщо не хочете змінювати)"
                               FontFamily="Bahnschrift"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,0,0,8"/>

                    <!-- TODO: Використати Data Binding для Visibility -->
                    <Border Background="#0E121B"
                            BorderBrush="#222A39"
                            BorderThickness="2"
                            CornerRadius="10"
                            Height="45"
                            Margin="0,0,0,5">
                        <Grid>
                            <!-- TODO: Використати Data Binding для Password (через helper behavior) замість PasswordChanged event -->
                            <PasswordBox x:Name="PasswordBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="White"
                                         FontFamily="Bahnschrift"
                                         FontSize="14"
                                         VerticalAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Padding="15,0,45,0"
                                         MaxLength="100"
                                         PasswordChanged="PasswordBox_PasswordChanged"/>

                            <!-- TODO: Використати Data Binding для Text -->
                            <!-- TODO: Використати Data Binding для Visibility -->
                            <TextBox x:Name="PasswordTextBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="White"
                                     FontFamily="Bahnschrift"
                                     FontSize="14"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Padding="15,0,45,0"
                                     MaxLength="100"
                                     Visibility="Collapsed"
                                     TextChanged="PasswordTextBox_TextChanged"/>

                            <!-- TODO: Використати Command замість Click event handler -->
                            <Button Content="👁"
                                    Width="40"
                                    Height="40"
                                    HorizontalAlignment="Right"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="White"
                                    FontSize="16"
                                    Cursor="Hand"
                                    Click="TogglePasswordVisibility_Click"/>
                        </Grid>
                    </Border>

                    <!-- TODO: Використати Data Binding для Text та Visibility -->
                    <TextBlock x:Name="PasswordErrorText"
                               Text=""
                               FontFamily="Bahnschrift"
                               FontSize="11"
                               Foreground="#FF6B6B"
                               Margin="5,0,0,5"
                               Visibility="Collapsed"/>

                    <TextBlock Text="Мінімум 8 символів, 1 велика літера, 1 цифра, 1 спецсимвол"
                               FontFamily="Bahnschrift"
                               FontSize="11"
                               Foreground="#666"
                               Margin="5,0,0,15"/>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2"
                  Margin="30,0,30,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Скасувати"
                        Height="45"
                        FontFamily="Bahnschrift"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Background="#0E121B"
                        Foreground="White"
                        BorderThickness="2"
                        BorderBrush="#222A39"
                        Cursor="Hand"
                        Click="CancelButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="#222A39"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- TODO: Використати Command замість Click event handler -->
                <Button x:Name="SaveButton"
                        Grid.Column="2"
                        Content="Зберегти зміни"
                        Height="45"
                        FontFamily="Bahnschrift"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="Black"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="SaveButton_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,0">
                            <GradientStop Color="#815A11"
                                          Offset="0"/>
                            <GradientStop Color="#FDE053"
                                          Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderThickness="0"
                                    CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
